<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.asaas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Asaas" name="asaas_base" logo="/asaas_base/static/description/icon.png">
                    <block title="Credenciais" name="asaas_credentials">
                        <setting string="Ambiente" help="Sandbox aprova as cobranças automaticamente e não movimenta dinheiro.">
                            <field name="asaas_environment" widget="radio" options="{'horizontal': true}"/>
                        </setting>
                        <setting string="Chave de API" help="Começa com $aact_hmlg_ no Sandbox e $aact_prod_ em Produção.">
                            <field name="asaas_api_key" password="True"/>
                            <div class="mt-2">
                                <button name="action_asaas_test_connection" type="object"
                                        string="Testar conexão" class="btn-link" icon="fa-plug"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Webhook" name="asaas_webhook">
                        <setting string="Token do webhook"
                                 help="Segredo combinado com o Asaas. Sem ele, o Odoo recusa todos os eventos.">
                            <field name="asaas_webhook_token" password="True"/>
                            <div class="mt-2">
                                <button name="action_asaas_sync_webhook" type="object"
                                        string="Registrar webhook no Asaas" class="btn-link" icon="fa-refresh"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Validação de saque" name="asaas_withdrawal">
                        <setting string="Endereço e token"
                                 help="Cadastre os dois em Asaas → Integrações → Mecanismos de segurança. O Odoo só aprova o que ele mesmo mandou pagar.">
                            <field name="asaas_withdrawal_url" readonly="1" widget="CopyClipboardChar"/>
                            <field name="asaas_withdrawal_token" widget="CopyClipboardChar"/>
                            <div class="mt-2">
                                <button name="action_asaas_generate_withdrawal_token" type="object"
                                        string="Gerar token" class="btn-link" icon="fa-key"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="asaas_webhook_event_view_tree" model="ir.ui.view">
        <field name="name">asaas.webhook.event.tree</field>
        <field name="model">asaas.webhook.event</field>
        <field name="arch" type="xml">
            <list string="Eventos Asaas" create="false" default_order="create_date desc">
                <field name="create_date" string="Recebido em"/>
                <field name="name"/>
                <field name="asaas_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'ignored'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="asaas_webhook_event_view_form" model="ir.ui.view">
        <field name="name">asaas.webhook.event.form</field>
        <field name="model">asaas.webhook.event</field>
        <field name="arch" type="xml">
            <form string="Evento Asaas" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="asaas_id"/>
                        <field name="state"/>
                        <field name="error" invisible="state != 'error'"/>
                    </group>
                    <field name="payload" widget="ace" options="{'mode': 'json'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asaas_webhook_event_action" model="ir.actions.act_window">
        <field name="name">Eventos do Asaas</field>
        <field name="res_model">asaas.webhook.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="asaas_withdrawal_validation_view_tree" model="ir.ui.view">
        <field name="name">asaas.withdrawal.validation.tree</field>
        <field name="model">asaas.withdrawal.validation</field>
        <field name="arch" type="xml">
            <list string="Validações de saque" create="false" edit="false">
                <field name="create_date" string="Recebido em"/>
                <field name="name"/>
                <field name="asaas_id"/>
                <field name="value" sum="Total"/>
                <field name="decision" widget="badge"
                       decoration-success="decision == 'approved'"
                       decoration-warning="decision == 'retry'"
                       decoration-danger="decision == 'refused'"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="asaas_withdrawal_validation_view_form" model="ir.ui.view">
        <field name="name">asaas.withdrawal.validation.form</field>
        <field name="model">asaas.withdrawal.validation</field>
        <field name="arch" type="xml">
            <form string="Validação de saque" create="false" edit="false">
                <header>
                    <button name="action_open_record" type="object" string="Abrir registro"
                            invisible="not res_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="operation_type" invisible="name"/>
                            <field name="asaas_id"/>
                            <field name="value"/>
                        </group>
                        <group>
                            <field name="decision"/>
                            <field name="reason"/>
                            <field name="create_date" string="Recebido em"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="payload" widget="ace" options="{'mode': 'json'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asaas_withdrawal_validation_action" model="ir.actions.act_window">
        <field name="name">Validações de saque</field>
        <field name="res_model">asaas.withdrawal.validation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_asaas_webhook_event"
              name="Eventos do Asaas"
              parent="base.menu_administration"
              action="asaas_webhook_event_action"
              groups="base.group_system"
              sequence="90"/>

    <menuitem id="menu_asaas_withdrawal_validation"
              name="Validações de saque do Asaas"
              parent="base.menu_administration"
              action="asaas_withdrawal_validation_action"
              groups="base.group_system"
              sequence="91"/>

</odoo>

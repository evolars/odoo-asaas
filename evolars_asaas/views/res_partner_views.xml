<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_partner_form_asaas" model="ir.ui.view">
    <field name="name">res.partner.form.asaas</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button class="oe_stat_button" type="object" name="action_view_asaas_payments" icon="fa-money">
          <field string="Cobranças Asaas" name="asaas_payment_count" widget="statinfo"/>
        </button>
        <button class="oe_stat_button" type="object" name="action_view_asaas_subscriptions" icon="fa-repeat">
          <field string="Assinaturas Asaas" name="asaas_subscription_count" widget="statinfo"/>
        </button>
        <button class="oe_stat_button" type="object" name="action_sync_asaas_customer" icon="fa-refresh">
          <div class="o_stat_info">
            <span class="o_stat_text">Sincronizar Asaas</span>
          </div>
        </button>
      </div>
      <xpath expr="//field[@name='vat']" position="after">
        <field name="notification_channel" widget="radio" options="{'horizontal': true}"/>
      </xpath>
    </field>
  </record>

</odoo>

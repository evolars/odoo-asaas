<odoo>
  <record id="view_contract_contract_form_asaas" model="ir.ui.view">
    <field name="name">contract.contract.form.asaas</field>
    <field name="model">contract.contract</field>
    <field name="inherit_id" ref="contract.contract_contract_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button class="oe_stat_button" type="object" name="action_view_asaas_subscriptions" icon="fa-repeat">
          <field name="asaas_subscription_count" widget="statinfo" string="Assinaturas Asaas"/>
        </button>
      </xpath>
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="notification_channel"/>
      </xpath>
    </field>
  </record>
</odoo>


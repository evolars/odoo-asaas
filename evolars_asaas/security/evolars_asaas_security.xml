<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_asaas" model="ir.module.category">
        <field name="name">Evolars Financeiro</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_asaas" model="res.groups.privilege">
        <field name="name">Evolars Financeiro</field>
        <field name="category_id" ref="module_category_asaas"/>
    </record>

    <record id="group_asaas_user" model="res.groups">
        <field name="name">Asaas Usuário</field>
        <field name="privilege_id" ref="res_groups_privilege_asaas"/>
    </record>

    <record id="group_asaas_manager" model="res.groups">
        <field name="name">Asaas Gestor</field>
        <field name="privilege_id" ref="res_groups_privilege_asaas"/>
        <field name="implied_ids" eval="[(4, ref('group_asaas_user'))]"/>
    </record>

    <!-- ADR-019: Concessão obrigatória de acesso universal para todos os usuários internos (base.group_user) -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_asaas_user'))]"/>
    </record>

    <record id="rule_asaas_payment_company" model="ir.rule">
        <field name="name">Cobranças Asaas por empresa</field>
        <field name="model_id" ref="model_evolars_asaas_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_asaas_user'))]"/>
    </record>

    <record id="rule_asaas_subscription_company" model="ir.rule">
        <field name="name">Assinaturas Asaas por empresa</field>
        <field name="model_id" ref="model_evolars_asaas_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_asaas_user'))]"/>
    </record>

    <record id="rule_asaas_event_company" model="ir.rule">
        <field name="name">Eventos Asaas por empresa</field>
        <field name="model_id" ref="model_evolars_asaas_webhook_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_asaas_user'))]"/>
    </record>
</odoo>

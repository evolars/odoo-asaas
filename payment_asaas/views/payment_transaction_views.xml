<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_transaction_form" model="ir.ui.view">
        <field name="name">payment.transaction.form.asaas</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <field name="provider_reference" position="after">
                <field name="asaas_invoice_number" invisible="provider_code != 'asaas'"/>
                <field name="asaas_billing_type" invisible="provider_code != 'asaas'"/>
                <field name="asaas_status" invisible="provider_code != 'asaas'"/>
            </field>
        </field>
    </record>

    <record id="payment_transaction_list" model="ir.ui.view">
        <field name="name">payment.transaction.list.asaas</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_list"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="asaas_invoice_number" optional="hide"/>
                <field name="asaas_billing_type" optional="hide"/>
                <field name="asaas_status" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
